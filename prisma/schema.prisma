generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  location String
  country  String
  city     String
  intake   String // Comma-separated string
  degree   String // Comma-separated string
  taught   String // Comma-separated string

  // Rankings
  rankingCountry  Int?
  rankingWorld    Int?
  rankingNational Int?

  // Details
  majors         String // Comma-separated string
  tuition        String
  tuitionDetails String // JSON string

  documents String // JSON string

  // Deadlines
  deadlineApplication String?
  deadlineStartDate   String?

  notes       String // JSON string
  badges      String // JSON string
  logo        String?
  isActive    Boolean @default(true)
  officialUrl String?
  aliases     String // JSON string
  legacySlugs String // JSON string

  relationshipType        String    @default("unverified")
  relationshipEvidenceUrl String?
  recognitionAuthority    String?
  recognitionSourceUrl    String?
  sourceUrls              String // JSON string
  lastVerifiedAt          DateTime?
  verificationExpiresAt   DateTime?
  verificationStatus      String    @default("under_verification")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs       Program[]
  fees           Fee[]
  scholarships   Scholarship[]
  costPlans      CostPlan[]
  evidenceAssets EvidenceAsset[]
}

model Program {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  level                   String
  name                    String
  subject                 String?
  languages               String // Comma-separated string
  duration                String?
  intakes                 String // Comma-separated string
  tuition                 String?
  tuitionAfterScholarship String?
  applicationDeadline     String?
  eligibility             String // JSON string
  sourceUrl               String?
  status                  String     @default("active")
  costPlans               CostPlan[]
}

model Fee {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  item       String
  cost       String
  notes      String?
  recipient  String?
  refundable String  @default("")
  validFor   String?
  sourceUrl  String?
}

model Scholarship {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  title            String
  type             String?
  details          String // JSON string
  amount           String?
  condition        String?
  eligiblePrograms String // JSON string
  coverage         String?
  renewal          String?
  deadline         String?
  sourceUrl        String?
  status           String     @default("active")
  costPlans        CostPlan[]
}

// One written cost view for one university/program/scholarship combination.
// Amounts remain strings so the admin can retain official currency formatting.
model CostPlan {
  id                       String       @id @default(cuid())
  universityId             String
  university               University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programId                String?
  program                  Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  scholarshipId            String?
  scholarship              Scholarship? @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)
  title                    String
  programName              String?
  scholarshipTitle         String?
  intake                   String?
  currency                 String       @default("CNY")
  tuitionBeforeScholarship String?
  scholarshipValue         String?
  tuitionAfterScholarship  String?
  applicationFee           String?
  hostel                   String?
  insurance                String?
  medical                  String?
  visa                     String?
  travel                   String?
  living                   String?
  serviceFee               String?
  otherCosts               String       @default("[]")
  totalEstimate            String?
  notes                    String       @default("[]")
  sourceUrl                String?
  lastVerifiedAt           DateTime?
  isPublished              Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

// Public proof is published only after redaction/privacy review.
model EvidenceAsset {
  id             String      @id @default(cuid())
  type           String
  title          String
  summary        String?
  organization   String?
  country        String?
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  referenceLabel String?
  documentUrl    String?
  thumbnailUrl   String?
  sourceUrl      String?
  issuedAt       DateTime?
  validUntil     DateTime?
  lastVerifiedAt DateTime?
  privacyStatus  String      @default("pending")
  isPublished    Boolean     @default(false)
  displayOrder   Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TrustMetric {
  id             String    @id @default(cuid())
  key            String    @unique
  value          String
  label          String
  definition     String
  evidenceNote   String?
  lastVerifiedAt DateTime?
  isPublished    Boolean   @default(false)
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ServicePackage {
  id              String   @id @default(cuid())
  slug            String   @unique
  destination     String
  title           String
  packageType     String
  priceLabel      String
  summary         String
  outcomeScope    String
  includedItems   String   @default("[]")
  excludedItems   String   @default("[]")
  paymentTerms    String
  refundTerms     String
  securityOptions String   @default("[]")
  complianceNote  String
  isPublished     Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Office {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  address        String
  city           String
  postalCode     String?
  phonePrimary   String
  phoneSecondary String?
  email          String?
  hours          String
  mapUrl         String?
  photoUrl       String?
  isHeadOffice   Boolean   @default(false)
  isPublished    Boolean   @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TeamMember {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  role               String
  shortRole          String?
  bio                String?
  specialties        String    @default("[]")
  photoUrl           String?
  consentConfirmedAt DateTime?
  isPublished        Boolean   @default(false)
  displayOrder       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Lead {
  id                  String  @id @default(cuid())
  name                String
  email               String
  phone               String
  country             String
  program             String?
  message             String?
  status              String  @default("new")
  source              String
  leadType            String  @default("contact")
  destinationInterest String?
  assignedTeam        String  @default("general")
  assignedTo          String?
  riskFlag            Boolean @default(false)
  medicalProgram      Boolean @default(false)

  // Assessment fields embedded
  assessAcademicLevel      String?
  assessAcademicResults    String?
  assessSubject            String?
  assessBudget             String?
  assessIntake             String?
  assessLanguage           String?
  assessCareerGoal         String?
  assessPreferredCountries String? // JSON string

  notes                String?
  consentTimestamp     DateTime
  consentPolicyVersion String
  landingPage          String?
  utm                  String? // JSON string

  // Meta CRM integration: stage events are sent only when the visitor accepted
  // advertising tracking on the form. fbc/fbp are Meta's click and browser IDs.
  adTrackingConsent Boolean @default(false)
  metaFbc           String?
  metaFbp           String?

  // Native CRM pipeline & Student Live Tracking Portal fields
  publicToken        String?   @unique
  publicEnabled      Boolean   @default(true)
  applicationStage   String    @default("documents")
  university         String?
  degree             String?
  gpa                Float?
  visaDeadline       String?
  departureDate      String?
  nextFollowup       String?
  driveLink          String?
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("EmployeeLeads", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  universityApps  LeadUniversityApp[]
  documents       LeadDocument[]
  activities      ActivityEvent[]
  financeIncomes  FinanceIncome[]
  financeExpenses FinanceExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedEmployeeId])
  @@index([nextFollowup])
}

model Content {
  id                   String    @id @default(cuid())
  title                String
  slug                 String    @unique
  content              String
  excerpt              String?
  type                 String
  category             String?
  tags                 String? // JSON string
  categories           String? // JSON string
  featuredImage        String?
  isPublished          Boolean   @default(false)
  isFeatured           Boolean   @default(false)
  metaTitle            String?
  metaDescription      String?
  author               String
  reviewer             String?
  sourceUrls           String? // JSON string
  lastVerifiedAt       DateTime?
  nextReviewAt         DateTime?
  expiresAt            DateTime?
  // Application deadline the post is about. Unlike expiresAt it never hides
  // the post: before it the page shows "Apply by", after it a closed-round
  // notice with a next-intake call to action, so the URL keeps its ranking.
  deadlineAt           DateTime?
  complianceApprovedAt DateTime?
  seoApprovedAt        DateTime?
  publishedAt          DateTime?
  // Set when an intake announcement has closed. Archived posts stay reachable
  // for transparency and backlinks, but are noindexed and excluded from
  // sitemaps/RSS so they cannot compete with the current intake pages.
  archivedAt           DateTime?
  views                Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partnership {
  id                         String   @id @default(cuid())
  companyName                String?
  businessType               String   @default("other")
  businessRegistrationNumber String?
  businessLicense            String?
  website                    String?
  yearsInBusiness            Int      @default(0)
  contactPerson              String   @default("Unknown")
  email                      String   @default("unknown@example.com")
  phone                      String   @default("0000000000")
  alternatePhone             String?
  address                    String?
  city                       String?
  state                      String?
  country                    String?
  postalCode                 String?
  partnershipType            String   @default("company")
  targetCountries            String? // JSON string
  currentClients             Int      @default(0)
  monthlyTarget              Int      @default(0)
  experience                 String?
  currentPartners            String? // JSON string
  annualRevenue              String?
  investmentCapacity         String?
  expectedCommission         String?
  marketingChannels          String? // JSON string
  socialMediaPresence        String? // JSON string
  localNetwork               String?
  referralSources            String? // JSON string
  documents                  String? // JSON string
  motivation                 String?
  expectations               String?
  additionalInfo             String?
  status                     String   @default("pending")
  priority                   String   @default("medium")
  assignedTo                 String?
  reviewNotes                String?
  source                     String   @default("website")
  ipAddress                  String?
  userAgent                  String?
  consentTimestamp           DateTime?
  consentPolicyVersion       String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Testimonial {
  id                   String    @id @default(cuid())
  studentName          String
  displayName          String?
  content              String
  location             String?
  university           String?
  program              String?
  country              String?
  image                String?
  rating               Int       @default(5)
  featured             Boolean   @default(false)
  academicProfile      String?
  decisionFactors      String?
  applicationTimeline  String?
  serviceProvided      String?
  studentPaid          String?
  currentUpdate        String?
  consentVerified      Boolean   @default(false)
  consentEvidenceId    String?
  consentRecordedAt    DateTime?
  consentExpiresAt     DateTime?
  consentRevokedAt     DateTime?
  consentImageApproved Boolean   @default(false)
  isPublished          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("user")
  tokenVersion Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String
  fromName   String
  toUserId   String
  toEmail    String
  toName     String
  subject    String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Simple key/value store for editable site + integration settings
// (e.g. Meta Pixel ID, Meta Access Token, contact details).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Time-bound campaign content is stored separately from evergreen editorial
// pages so intake data can be updated without rebuilding the page design.
model IntakeCampaign {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  destination        String
  intake             String
  contentJson        String
  sourceLabel        String
  verificationStatus String    @default("preliminary")
  lastReviewedAt     DateTime?
  nextReviewAt       DateTime?
  isPublished        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model RateLimitBucket {
  key       String @id
  policy    String
  count     Int
  resetAtMs BigInt

  @@index([policy, resetAtMs])
  @@index([resetAtMs])
}

model Employee {
  id             String   @id @default(cuid())
  empId          String   @unique
  name           String
  role           String   @default("Counselor")
  email          String?
  phone          String?
  team           String   @default("china")
  specialization String?
  salary         Float    @default(0)
  active         Boolean  @default(true)
  joinDate       String?
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads           Lead[]           @relation("EmployeeLeads")
  attendances     Attendance[]
  dailyLogs       DailyLog[]
  kpiTargets      KpiTarget[]
  tasks           TaskDirective[]
  activities      ActivityEvent[]
  financeIncomes  FinanceIncome[]
  financeExpenses FinanceExpense[]
  payrolls        PayrollRecord[]

  @@index([active])
  @@index([team])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empId       String
  name        String
  date        String
  checkIn     String?
  checkOut    String?
  hoursWorked Float    @default(0)
  status      String   @default("Present")
  source      String   @default("manual")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([empId, date])
  @@index([date])
  @@index([employeeId, date])
}

model DailyLog {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empId           String
  date            String
  accomplishments String?
  challenges      String?
  tomorrowPlan    String?
  metricsJson     String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([empId, date])
  @@index([date])
}

model KpiTarget {
  id                 String    @id @default(cuid())
  employeeId         String?
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  consultant         String
  month              String
  targetLeads        Int       @default(0)
  targetEnrolled     Int       @default(0)
  targetRevenue      Float     @default(0)
  targetDailyActions Int       @default(12)
  targetFollowups    Int       @default(0)
  maxSlaHours        Int       @default(24)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([consultant, month])
  @@index([month])
}

model TaskDirective {
  id          String    @id @default(cuid())
  title       String
  details     String?
  assignedTo  String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedBy  String?
  dueDate     String?
  priority    String    @default("normal")
  status      String    @default("open")
  category    String?
  leadId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([dueDate])
}

model LeadUniversityApp {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  university    String
  program       String?
  status        String   @default("documents")
  applicationId String?
  submittedOn   String?
  decisionOn    String?
  notes         String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
}

model LeadDocument {
  id                 String    @id @default(cuid())
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  docType            String
  status             String    @default("pending")
  notes              String?
  fileUrl            String?
  studentUploadedUrl String?
  studentUploadedAt  DateTime?
  requestedByStudent Boolean   @default(false)
  receivedOn         String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId])
}

model ActivityEvent {
  id          String    @id @default(cuid())
  type        String
  actorName   String?
  actorUserId String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadName    String?
  fromValue   String?
  toValue     String?
  details     String?
  createdAt   DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([employeeId, createdAt])
  @@index([createdAt])
}

model GbpScheduledPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  topicType       String    @default("STANDARD") // STANDARD | OFFER | EVENT
  title           String?
  summary         String
  callToAction    String    @default("LEARN_MORE") // LEARN_MORE | BOOK | SIGN_UP | ORDER | SHOP
  ctaUrl          String
  mediaUrl        String?
  offerCouponCode String?
  offerRedeemUrl  String?
  offerTerms      String?
  startDate       DateTime?
  endDate         DateTime?
  language                String    @default("en") // en | bn | bilingual
  category                String    @default("general")
  targetChannels          String    @default("both") // both | gbp | linkedin
  linkedinCopy            String?
  sortOrder               Int       @default(100)
  status                  String    @default("queued") // queued | paused | published | failed
  isRecurring             Boolean   @default(true)
  publishedCount          Int       @default(0)
  lastPublishedAt         DateTime?
  lastExternalId          String?
  lastError               String?
  lastLinkedinPublishedAt DateTime?
  lastLinkedinExternalId  String?
  lastLinkedinError       String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status, sortOrder])
  @@index([lastPublishedAt])
}

model FinanceIncome {
  id              String    @id @default(cuid())
  legacyCrmId     Int?      @unique
  date            String
  month           String
  category        String?
  leadRef         String?
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName      String?
  studentName     String?
  reference       String?
  amount          Float     @default(0)
  notes           String?
  excludeFromCash Boolean   @default(false)
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([month])
  @@index([date])
  @@index([category])
  @@index([employeeId])
  @@index([leadId])
}

model FinanceExpense {
  id          String    @id @default(cuid())
  legacyCrmId Int?      @unique
  date        String
  month       String
  category    String?
  paidTo      String?
  leadRef     String?
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentName String?
  reference   String?
  amount      Float     @default(0)
  notes       String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([month])
  @@index([date])
  @@index([category])
  @@index([employeeId])
  @@index([leadId])
}

model PayrollRecord {
  id          String    @id @default(cuid())
  legacyCrmId Int?      @unique
  month       String
  empId       String
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  name        String
  baseSalary  Float     @default(0)
  daysWorked  Int       @default(0)
  workingDays Int       @default(0)
  bonus       Float     @default(0)
  deductions  Float     @default(0)
  netPay      Float     @default(0)
  paidOn      String?
  status      String    @default("pending")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([month, empId, name])
  @@index([month])
  @@index([employeeId])
}
