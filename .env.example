# === Security (REQUIRED in production) ===
# Generate a strong secret, e.g.:  openssl rand -base64 48
# The app REFUSES to run in production without a JWT_SECRET of 32+ chars.
JWT_SECRET=
# Optional dedicated 32+ char keys for encrypting DB secrets (metaAccessToken)
# and startup SQLite backups (defaults to key derived from JWT_SECRET if unset).
SETTINGS_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Dedicated 32+ char secret for POST /api/revalidate cache invalidation (never reuse JWT_SECRET;
# Docker entrypoint auto-generates an ephemeral secret per boot if omitted).
REVALIDATE_SECRET=

# Admin account provisioning/password rotation is CLI-only (never stored in .env
# or auto-provisioned on /api/auth/login): run `npm run seed:admin` interactively.
ADMIN_EMAIL=admin@eduexpressint.com

# === Search engine / Meta domain verification ===
# Paste the content value from each provider's verification snippet (not the whole tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# === Integrations ===
META_ACCESS_TOKEN=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=https://eduexpressint.com
NEXT_PUBLIC_SITE_NAME=EduExpress International
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
MONGODB_URI=
