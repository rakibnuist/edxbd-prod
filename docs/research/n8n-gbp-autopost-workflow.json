{
  "name": "EduExpress GBP & LinkedIn Auto-Poster (Weekly / 15-Day)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 11
            }
          ]
        }
      },
      "id": "trigger-daily-check",
      "name": "Daily Schedule Check (11:00 AM Asia/Dhaka)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://eduexpressint.com/api/cron/gbp-posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{$env.EDUEXPRESS_CRON_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-due-post",
      "name": "Fetch Next Due Post (GBP + LinkedIn)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-enabled-due",
              "leftValue": "={{($json.enabled === true || $json.linkedinEnabled === true) && $json.isDue === true && Boolean($json.nextPost)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-due",
      "name": "Is 7/15-Day Post Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://mybusinessaccountmanagement.googleapis.com/v1/accounts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "options": {}
      },
      "id": "discover-gbp-account",
      "name": "Discover GBP Account ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 320],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://mybusiness.googleapis.com/v4/' + ($json.accounts?.[0]?.name || 'accounts/REPLACE_WITH_ACCOUNT_ID') + '/locations/16688138993497254676/localPosts' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Fetch Next Due Post (GBP + LinkedIn)').item.json.googleLocalPostPayload) }}",
        "options": {}
      },
      "id": "publish-gbp",
      "name": "Publish to Google Business Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 320],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            },
            {
              "name": "Linkedin-Version",
              "value": "202610"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Fetch Next Due Post (GBP + LinkedIn)').item.json.linkedinPostPayload) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "publish-linkedin",
      "name": "Publish to LinkedIn Company Page (Org 30919158)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 320],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const due = $('Fetch Next Due Post (GBP + LinkedIn)').first().json;\nconst gbpOut = $('Publish to Google Business Profile').first()?.json || {};\nconst liOut = $('Publish to LinkedIn Company Page (Org 30919158)').first()?.json || {};\nconst gbpId = typeof gbpOut.name === 'string' && gbpOut.name.includes('localPosts') ? gbpOut.name : null;\nconst liHeaders = liOut.headers || {};\nconst linkedinId = liHeaders['x-restli-id'] || liHeaders['X-RestLi-Id'] || liOut.body?.id || liOut.id || null;\nconst okGbp = Boolean(gbpId);\nconst okLi = Boolean(linkedinId);\nif (!okGbp && !okLi) {\n  return [];\n}\nconst channel = okGbp && okLi ? 'both' : okGbp ? 'gbp' : 'linkedin';\nreturn [{ json: { postId: due.nextPost.id, channel, externalPostId: gbpId, linkedinExternalPostId: linkedinId } }];"
      },
      "id": "summarize-channels",
      "name": "Check Channel Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://eduexpressint.com/api/cron/gbp-posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{$env.EDUEXPRESS_CRON_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'ack', channel: $json.channel, postId: $json.postId, externalPostId: $json.externalPostId, linkedinExternalPostId: $json.linkedinExternalPostId, source: 'n8n_dual_workflow' }) }}",
        "options": {}
      },
      "id": "ack-eduexpress",
      "name": "Acknowledge GBP & LinkedIn Rotation in Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 320]
    }
  ],
