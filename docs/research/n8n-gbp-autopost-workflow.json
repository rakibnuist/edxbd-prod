{
  "name": "EduExpress GBP & LinkedIn Auto-Poster (Weekly / 15-Day)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "trigger-daily-check",
      "name": "Daily Schedule Check (09:00 UTC / 15:00 BST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://eduexpressint.com/api/cron/gbp-posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{$env.EDUEXPRESS_CRON_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-due-post",
      "name": "Fetch Next Due Post (GBP + LinkedIn)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-enabled-due",
              "leftValue": "={{($json.enabled === true || $json.linkedinEnabled === true) && $json.isDue === true && Boolean($json.nextPost)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-due",
      "name": "Is 7/15-Day Post Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mybusiness.googleapis.com/v4/accounts/REPLACE_WITH_ACCOUNT_ID/locations/16688138993497254676/localPosts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.googleLocalPostPayload) }}",
        "options": {}
      },
      "id": "publish-gbp",
      "name": "Publish to Google Business Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            },
            {
              "name": "Linkedin-Version",
              "value": "202610"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Fetch Next Due Post (GBP + LinkedIn)').item.json.linkedinPostPayload) }}",
        "options": {}
      },
      "id": "publish-linkedin",
      "name": "Publish to LinkedIn Company Page (Org 30919158)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 440],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://eduexpressint.com/api/cron/gbp-posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{$env.EDUEXPRESS_CRON_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'ack', channel: 'both', postId: $('Fetch Next Due Post (GBP + LinkedIn)').item.json.nextPost.id, externalPostId: $('Publish to Google Business Profile').item.json.name || null, linkedinExternalPostId: $('Publish to LinkedIn Company Page (Org 30919158)').item.json.id || null, source: 'n8n_dual_workflow' }) }}",
        "options": {}
      },
      "id": "ack-eduexpress",
      "name": "Acknowledge GBP & LinkedIn Rotation in Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 320]
    }
  ],
  "connections": {
    "Daily Schedule Check (09:00 UTC / 15:00 BST)": {
      "main": [
        [
          {
            "node": "Fetch Next Due Post (GBP + LinkedIn)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Next Due Post (GBP + LinkedIn)": {
      "main": [
        [
          {
            "node": "Is 7/15-Day Post Due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is 7/15-Day Post Due?": {
      "main": [
        [
          {
            "node": "Publish to Google Business Profile",
            "type": "main",
            "index": 0
          },
          {
            "node": "Publish to LinkedIn Company Page (Org 30919158)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Google Business Profile": {
      "main": [
        [
          {
            "node": "Acknowledge GBP & LinkedIn Rotation in Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to LinkedIn Company Page (Org 30919158)": {
      "main": [
        [
          {
            "node": "Acknowledge GBP & LinkedIn Rotation in Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  }
}
